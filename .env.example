# База данных
DATABASE_URL="postgresql://polka:password@localhost:5432/polka_db"
# Размер пула соединений (необязательно, по умолчанию 10).
# Для нестабильного локального Prisma Dev ставьте 1 в .env.local.
# DB_POOL_MAX="10"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Telegram (для Login Widget и уведомлений)
TELEGRAM_BOT_TOKEN="bot_token_from_botfather"
TELEGRAM_BOT_SECRET="random-webhook-secret"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="your_bot_username"

# Yandex Object Storage (S3)
YANDEX_S3_ACCESS_KEY="..."
YANDEX_S3_SECRET_KEY="..."
YANDEX_S3_BUCKET="polka-files"
YANDEX_S3_ENDPOINT="https://storage.yandexcloud.net"
YANDEX_S3_REGION="ru-central1"

# Т-Банк (интернет-эквайринг). Notification URL в кабинете → /api/payment/webhook
TBANK_TERMINAL_KEY="..."
TBANK_PASSWORD="..."

# Email-уведомления (SMTP)
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="noreply@polka.app"
SMTP_PASS="..."
SMTP_FROM="\"ПОЛКА\" <noreply@polka.app>"

# Sentry (мониторинг ошибок)
SENTRY_DSN="https://xxx@yyy.ingest.sentry.io/zzz"
NEXT_PUBLIC_SENTRY_DSN="https://xxx@yyy.ingest.sentry.io/zzz"
SENTRY_AUTH_TOKEN="..."

# Приложение
NEXT_PUBLIC_APP_URL="http://localhost:3000"
COMMISSION_RATE="0.20"
ESCROW_DAYS="7"

# Разрешённые домены почты при регистрации (через запятую).
# Пусто — разрешены любые. Поддомены разрешённого домена тоже проходят.
# Проверка на сервере — это источник истины.
ALLOWED_EMAIL_DOMAINS="yandex.ru"
# Зеркало для подсказки в форме (опционально, только UX). Держите в синхроне.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS="yandex.ru"

# Yandex SmartCaptcha (капча на регистрации, опционально). Пусто — выключена.
# Клиентский ключ публичный (виджет), серверный — проверка токена на /validate.
NEXT_PUBLIC_SMARTCAPTCHA_SITE_KEY=""
SMARTCAPTCHA_SERVER_KEY=""

# Режим техработ: "1" — все маршруты отдают /maintenance (нужен перезапуск).
# Пусто/0 — обычная работа. Email и ссылка на статус для страницы техработ.
MAINTENANCE_MODE=""
SUPPORT_EMAIL="support@polka.ru"
STATUS_URL=""

# ── Access-guard: анти-VPN / прокси / дата-центр / гео ───────────────────────
# ГЛАВНЫЙ РУБИЛЬНИК: "1" — модуль включён, пусто — полностью выключен (0 нагрузки).
ACCESS_GUARD_ENABLED=""
# Независимые проверки (включаются по отдельности при включённом рубильнике):
ACCESS_GUARD_VPN_API=""          # вариант 1: VPN/прокси по API репутации
ACCESS_GUARD_ASN=""              # вариант 2: блок дата-центровых ASN
ACCESS_GUARD_GEO=""              # вариант 3: только разрешённые страны
# API репутации (для VPN-проверки; заодно даёт ASN и страну для вариантов 2/3):
ACCESS_GUARD_API_PROVIDER="proxycheck"   # proxycheck | vpnapi
ACCESS_GUARD_API_KEY=""          # ключ proxycheck.io / vpnapi.io (есть бесплатные лимиты)
# Гео: разрешённые страны (ISO, через запятую). Пусто = гео-проверка ничего не режет.
ACCESS_GUARD_ALLOWED_COUNTRIES="RU"
# Доп. ASN к встроенному списку дата-центров (через запятую, без "AS").
ACCESS_GUARD_DENY_ASNS=""
# Обходной список IP/CIDR (свои офисы/партнёры) — без проверки.
ACCESS_GUARD_ALLOWLIST=""
ACCESS_GUARD_CACHE_TTL_MS="3600000"   # кэш вердиктов по IP (мс)
ACCESS_GUARD_FAIL_OPEN="1"            # при ошибке API пускать (не запирать клиентов)

# AI-ревью кода
# Провайдер: gemini | ollama | yandexgpt | disabled
AI_REVIEW_PROVIDER="disabled"

# Вариант A: Gemini (Google AI Studio → aistudio.google.com)
GEMINI_API_KEY="..."

# Вариант B: Ollama (локальный сервер)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gemma3:12b"

# Вариант C: YandexGPT
YANDEX_GPT_API_KEY="..."
YANDEX_FOLDER_ID="..."

# VirusTotal — hash-check (не загружает файлы, только проверяет хеш)
# Бесплатный план: 4 запроса/мин, 500/день. Получить ключ: virustotal.com/gui/my-apikey
# Оставьте пустым, чтобы отключить (продукты с файлами пойдут в ручную очередь если и AI тоже отключен)
VIRUSTOTAL_API_KEY=""

# Cron-задачи (эскроу, AI-очередь)
# Обязательно: минимум 32 случайных символа. Сгенерировать: openssl rand -base64 32
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Резервное копирование и мониторинг (для scripts/backup.sh, monitor.sh — на сервере)
# Отдельный бакет и сервисный аккаунт, НЕ те же ключи, что у YANDEX_S3_* (защита бэкапов)
BACKUP_S3_BUCKET="polka-backups"
BACKUP_S3_ENDPOINT="https://storage.yandexcloud.net"
# AWS CLI берёт ключи из AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (бакет-only аккаунт)
# Алерты мониторинга в Telegram (chat_id администратора/группы)
TELEGRAM_ALERT_CHAT_ID=""

# Прод-пароль БД для docker-compose.prod.yml (openssl rand -base64 24); тот же в DATABASE_URL
POSTGRES_PASSWORD=""

# E2E тесты (Playwright)
PLAYWRIGHT_BASE_URL="http://localhost:3000"
E2E_DEV_EMAIL="dev@polka.test"
E2E_DEV_PASS="devpassword123"
E2E_BUYER_EMAIL="buyer@polka.test"
E2E_BUYER_PASS="buyerpassword123"

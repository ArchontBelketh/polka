# ============================================================================
#  ПОЛКА — переменные окружения для ПРОДАКШНА (сервер)
# ----------------------------------------------------------------------------
#  Скопируйте в .env рядом с docker-compose.yml:  cp .env.production.example .env
#  Этот файл читают: docker compose (интерполяция) и приложение (env_file).
#
#  Значения, помеченные [AUTO], скрипт scripts/server-setup.sh заполнит сам
#  (сгенерирует секреты). Остальное заполните своими данными ДО запуска.
# ============================================================================

# ── Домен и HTTPS (используются скриптом для nginx + Let's Encrypt) ──────────
DOMAIN="example.com"                 # ваш домен, A-запись уже указывает на сервер
LETSENCRYPT_EMAIL="you@example.com"  # email для уведомлений об истечении TLS

# ── Первый администратор (создаётся скриптом) ───────────────────────────────
ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD оставьте пустым — скрипт сгенерирует и покажет его один раз.
ADMIN_PASSWORD=""

# ── База данных ─────────────────────────────────────────────────────────────
# Хост = db (имя сервиса в compose-сети). Пароль = POSTGRES_PASSWORD ниже.
POSTGRES_PASSWORD=""                 # [AUTO] сильный пароль
DATABASE_URL="postgresql://polka:CHANGEME@db:5432/polka_db"  # [AUTO] подставит пароль

# ── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=""                   # [AUTO] openssl rand -base64 32
NEXTAUTH_URL="https://example.com"   # [AUTO из DOMAIN]
NEXT_PUBLIC_APP_URL="https://example.com"  # [AUTO из DOMAIN]

# ── Ограничение доменов почты при регистрации (необязательно) ───────────────
ALLOWED_EMAIL_DOMAINS=""
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=""

# ── Cron (эскроу, AI-очередь) ───────────────────────────────────────────────
CRON_SECRET=""                       # [AUTO] openssl rand -base64 32

# ── Telegram (Login Widget + уведомления) ───────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_SECRET=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# ── Объектное хранилище (Yandex Cloud S3) ───────────────────────────────────
YANDEX_S3_ACCESS_KEY=""
YANDEX_S3_SECRET_KEY=""
YANDEX_S3_BUCKET="polka-files"
YANDEX_S3_ENDPOINT="https://storage.yandexcloud.net"
YANDEX_S3_REGION="ru-central1"

# ── Т-Банк (интернет-эквайринг) ─────────────────────────────────────────────
# Notification URL в кабинете терминала → https://домен/api/payment/webhook
TBANK_TERMINAL_KEY=""
TBANK_PASSWORD=""
# Онлайн-касса (Чеки Т-Бизнеса): СНО оператора и ставка НДС для чека за услуги.
# ИП на УСН «Доходы» → usn_income / none.
RECEIPT_TAXATION="usn_income"
RECEIPT_VAT="none"
# Агентский чек покупателю за товар (Чек А). Включать ТОЛЬКО после проверки на
# DEMO и подтверждения версии ФФД у Т-Банка.
RECEIPT_AGENT_ENABLED="false"
RECEIPT_AGENT_SIGN="attorney"
RECEIPT_PRODUCT_PAYMENT_OBJECT="service"

# ── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="\"ПОЛКА\" <noreply@example.com>"

# ── Приложение ──────────────────────────────────────────────────────────────
COMMISSION_RATE="0.20"
ESCROW_DAYS="7"
MAINTENANCE_MODE=""
SUPPORT_EMAIL="support@example.com"
STATUS_URL=""

# ── Access-guard: анти-VPN / прокси / дата-центр / гео ───────────────────────
ACCESS_GUARD_ENABLED=""          # ГЛАВНЫЙ РУБИЛЬНИК ("1" вкл / пусто выкл)
ACCESS_GUARD_VPN_API=""          # вариант 1: VPN/прокси по API
ACCESS_GUARD_ASN=""              # вариант 2: дата-центровые ASN
ACCESS_GUARD_GEO=""              # вариант 3: только разрешённые страны
ACCESS_GUARD_API_PROVIDER="proxycheck"
ACCESS_GUARD_API_KEY=""
ACCESS_GUARD_ALLOWED_COUNTRIES="RU"
ACCESS_GUARD_DENY_ASNS=""
ACCESS_GUARD_ALLOWLIST=""
ACCESS_GUARD_CACHE_TTL_MS="3600000"
ACCESS_GUARD_FAIL_OPEN="1"

# ── AI-ревью кода ───────────────────────────────────────────────────────────
# Провайдер и ключ задаются в админке (Настройки → ИИ-ревью), не в env.

# ── VirusTotal (опционально) ────────────────────────────────────────────────
VIRUSTOTAL_API_KEY=""

# ── Sentry (опционально) ────────────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ── Yandex SmartCaptcha (капча на регистрации, опционально) ──────────────────
# Пусто — капча выключена. Ключи: console.yandex.cloud → SmartCaptcha.
# Клиентский ключ публичный (виджет) и должен быть задан ДО сборки образа
# (NEXT_PUBLIC_* инлайнится в бандл на этапе build). Серверный ключ — секрет,
# нужен только в runtime для проверки токена на /validate.
NEXT_PUBLIC_SMARTCAPTCHA_SITE_KEY=""
SMARTCAPTCHA_SERVER_KEY=""

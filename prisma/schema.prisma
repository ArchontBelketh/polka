generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  DEVELOPER
  MODERATOR
  ADMIN
}

enum Category {
  TELEGRAM
  PARSER
  EXCEL
  AUTOMATION
  WEB
}

enum ProductStatus {
  DRAFT
  PENDING
  SCAN_FAILED
  APPROVED
  REJECTED
  SUSPENDED
}

enum ScanStatus {
  PENDING
  CLEAN
  WARNING
  BLOCKED
}

enum PurchaseStatus {
  PENDING
  PAID
  DELIVERED
  REFUNDED
  DISPUTED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
}

enum TicketCategory {
  APPEAL
  PURCHASE
  BUG
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum FileType {
  SOURCE
  BINARY
  DECOMPILED
}

enum ProductVersionStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id             String     @id @default(cuid())
  email          String?    @unique
  emailVerified  DateTime?
  name           String?
  telegramId     String?    @unique
  telegramHandle String?
  phone          String?
  role           Role       @default(BUYER)
  inn            String?
  passwordHash   String?
  agreedToTerms  Boolean    @default(false)
  agreedAt       DateTime?
  balance        Int        @default(0)
  bio            String?    @db.Text
  isBanned       Boolean    @default(false)
  bannedAt       DateTime?
  banReason      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  products        Product[]
  purchases       Purchase[]
  reviews         Review[]
  payouts         Payout[]
  accounts        Account[]
  sessions        Session[]
  wishlists       Wishlist[]
  supportTickets  SupportTicket[]
  ticketMessages  TicketMessage[]
  developerPlan   DeveloperPlan?
  slotPurchases   SlotPurchase[]
  aiReviews       AiReview[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  access_token      String? @db.Text
  refresh_token     String? @db.Text
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id                  String          @id @default(cuid())
  title               String
  slug                String          @unique
  shortDesc           String
  fullDesc            String          @db.Text
  category            Category
  price               Int
  status              ProductStatus   @default(DRAFT)
  authorId            String
  features            String[]
  screenshots         String[]
  demoUrl             String?
  videoUrl            String?
  targetAudience      String?
  techStack           String[]        @default([])
  license             String          @default("personal")
  telegramBotUsername String?
  rating              Float           @default(0)
  reviewCount         Int             @default(0)
  salesCount          Int             @default(0)
  riskScore           Int?
  autoDecision        String?
  aiReviewFlags       Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  publishedAt         DateTime?
  author              User            @relation(fields: [authorId], references: [id])
  files               ProductFile[]
  purchases           Purchase[]
  reviews             Review[]
  scanResult          ScanResult?
  moderationLogs      ModerationLog[]
  wishlists           Wishlist[]
  supportTickets      SupportTicket[]
  versions            ProductVersion[]
  aiReviews           AiReview[]

  @@index([status])
  @@index([category])
  @@index([authorId])
}

model ProductFile {
  id        String   @id @default(cuid())
  productId String
  s3Key     String
  fileName  String
  fileSize  Int
  fileType  FileType
  format    String
  version   String   @default("1.0.0")
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ScanResult {
  id        String     @id @default(cuid())
  productId String     @unique
  status    ScanStatus @default(PENDING)
  findings  Json       @default("[]")
  scannedAt DateTime?
  toolsRun  String[]
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ModerationLog {
  id          String   @id @default(cuid())
  productId   String
  moderatorId String?
  action      String
  comment     String?
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id])
}

model Purchase {
  id            String         @id @default(cuid())
  buyerId       String
  productId     String
  amount        Int
  status        PurchaseStatus @default(PENDING)
  paymentId     String?
  escrowUntil   DateTime?
  downloadCount Int            @default(0)
  createdAt     DateTime       @default(now())
  paidAt        DateTime?
  buyer         User           @relation(fields: [buyerId], references: [id])
  product       Product        @relation(fields: [productId], references: [id])

  @@index([buyerId])
  @@index([productId])
  @@index([escrowUntil])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  authorId  String
  rating    Int
  text      String   @db.Text
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])

  @@unique([productId, authorId])
}

model Payout {
  id          String       @id @default(cuid())
  developerId String
  amount      Int
  status      PayoutStatus @default(PENDING)
  requestedAt DateTime     @default(now())
  paidAt      DateTime?
  developer   User         @relation(fields: [developerId], references: [id])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model SupportTicket {
  id        String         @id @default(cuid())
  authorId  String
  subject   String
  category  TicketCategory
  productId String?
  status    TicketStatus   @default(OPEN)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  author    User           @relation(fields: [authorId], references: [id])
  product   Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  messages  TicketMessage[]

  @@index([authorId])
  @@index([status])
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  authorId  String
  text      String        @db.Text
  isStaff   Boolean       @default(false)
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id])
}

model ProductVersion {
  id               String               @id @default(cuid())
  productId        String
  version          String
  changelog        String?              @db.Text
  s3Key            String               @default("")
  fileName         String               @default("")
  fileSize         Int                  @default(0)
  status           ProductVersionStatus @default(PENDING)
  moderatorComment String?
  autoApproved     Boolean              @default(false)
  riskScore        Int?
  createdAt        DateTime             @default(now())
  product          Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([status])
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  discountPct Int       // 1–100
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())

  @@index([code])
}

model DeveloperPlan {
  id         String    @id @default(cuid())
  userId     String    @unique
  plan       String    @default("FREE")  // FREE | PRO
  totalSlots Int       @default(2)
  proUntil   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SlotPurchase {
  id         String   @id @default(cuid())
  userId     String
  slotsAdded Int
  amount     Int
  paymentId  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AiReview {
  id          String    @id @default(cuid())
  productId   String
  requestedBy String
  paymentId   String?
  status      String    @default("PENDING")  // PENDING | PROCESSING | DONE | FAILED
  result      Json?
  amount      Int       @default(39000)
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [requestedBy], references: [id], onDelete: Cascade)

  @@index([requestedBy])
  @@index([status])
}
